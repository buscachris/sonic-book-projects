# Blender keeps local recovery copies; the authored .blend is versioned.
*.blend[0-9]*
*.blend@
*.blend~
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
.idea/
.vscode/

# Unity: retain Assets (including .meta), Packages, and ProjectSettings.
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Bb]uild/
**/[Bb]uilds/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/
*.csproj
*.sln
*.slnx
*.pidb
*.booproj
*.userprefs
*.unitypackage

# Machine-specific logs and credentials never belong in the collection.
*.log
.env
.env.*
!.env.example
